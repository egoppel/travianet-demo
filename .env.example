# --- backend (docker-compose.yml) ---
API_HOST=travianet.voiceaidemo.avvid.nl
# Shared secret the LiveHub tools send as X-Api-Key. Generate with: openssl rand -hex 24
API_KEY=
# Enables /api/admin/* (reset demo data, inspect state) and GET /api/v1/handovers
ADMIN_KEY=
TOKEN_TTL_MINUTES=30
MAX_AUTH_ATTEMPTS=2
MAX_FORMAT_ERRORS=3

# --- LiveHub provisioning (livehub/provision.mjs) ---
LIVEHUB_CLIENT_ID=
LIVEHUB_CLIENT_SECRET=
# Public base URL of the backend as LiveHub reaches it
TRAVIANET_API_URL=https://travianet.voiceaidemo.avvid.nl
# Sikom transfer targets (phone number or sip: URI) per flowchart service
SIKOM_SERVICE_2=
SIKOM_SERVICE_3=
SIKOM_SERVICE_4=
